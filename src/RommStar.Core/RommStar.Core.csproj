<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<TargetFramework>net9.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Configurations>Debug;Release;Patch;Major</Configurations>
		<!-- Hide null warnings from build log: -->
		<NoWarn>CS8618;CS8602;CS8604;CS8625;CS8601;CS8767;CS8603;CS0162</NoWarn>
	</PropertyGroup>

	<!-- INCREMENT VERSION CODE -->
	<Target Name="IncrementVersion" BeforeTargets="GetAssemblyVersion" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' == 'true' And '$(VersionIncremented)' == ''">
		<!-- Executes the PowerShell script, passing the current Configuration (Debug, Release, etc.) -->
		<Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(SolutionDir)build\scripts\versionIncrement.ps1&quot; -Config &quot;$(Configuration)&quot; -VersionFile &quot;$(MSBuildProjectDirectory)\rommstar.version.txt&quot;" ConsoleToMSBuild="true">
			<!-- Captures the script's output and applies it to the .dll version properties -->
			<Output TaskParameter="ConsoleOutput" PropertyName="Version" />
			<Output TaskParameter="ConsoleOutput" PropertyName="AssemblyVersion" />
			<Output TaskParameter="ConsoleOutput" PropertyName="FileVersion" />
		</Exec>

		<!-- Tripwire property to ensure this target only fires exactly once per real build -->
		<PropertyGroup>
			<VersionIncremented>true</VersionIncremented>
		</PropertyGroup>
	</Target>

	<!-- PACKAGE RELEASE CODE -->
	<Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Patch' Or '$(Configuration)' == 'Major'">

		<PropertyGroup>
			<!-- 1. Define our tidy output paths inside the build/releases directory -->
			<ReleaseFolder>$(SolutionDir)build\releases\</ReleaseFolder>
			<StagingRoot>$(ReleaseFolder)Staging\</StagingRoot>
			<StagingRommStar>$(StagingRoot)RommStar\</StagingRommStar>

			<!-- 2. Dynamically name the zip using the Version number we generated earlier! -->
			<FinalZipPath>$(ReleaseFolder)RommStar_v$(Version).zip</FinalZipPath>
		</PropertyGroup>

		<!-- 3. Wipe the staging folder and delete any identically named zip from a previous build -->
		<RemoveDir Directories="$(StagingRoot)" />
		<Delete Files="$(FinalZipPath)" />

		<!-- 4. Grab everything in the build output and copy it into the tidy RommStar folder -->
		<ItemGroup>
			<FilesToZip Include="$(TargetDir)**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(FilesToZip)" DestinationFolder="$(StagingRommStar)%(RecursiveDir)" />

		<!-- 5. Native MSBuild ZIP command! (Zips the Staging folder, so 'RommStar' is the root inside the zip) -->
		<ZipDirectory SourceDirectory="$(StagingRoot)" DestinationFile="$(FinalZipPath)" />

		<!-- 6. Delete the unzipped staging folder to keep the 'Releases' directory perfectly clean -->
		<RemoveDir Directories="$(StagingRoot)" />

	</Target>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Major|AnyCPU'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Patch|AnyCPU'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="UI\Rommstar\**" />
		<EmbeddedResource Remove="UI\Rommstar\**" />
		<None Remove="UI\Rommstar\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Mappers\LaunchboxEmulatorMapper.cs" />
		<Compile Remove="Mappers\LaunchboxPlatformMapper.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Monikers.imagemanifest" />
		<None Remove="Resources\LogoBox.ico" />
		<None Remove="Resources\LogoBox128px.png" />
		<None Remove="Resources\rommIcon64px.ico" />
		<None Remove="Resources\rommIcon64px.png" />
	</ItemGroup>

	<ItemGroup>
		<content Include="Monikers.imagemanifest">
			<IncludeInVSIX>true</IncludeInVSIX>
		</content>
		<Content Include="Game Installation Required">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Drawing.Common" Version="9.0.0">
			<HintPath>..\..\lib\launchbox\System.Drawing.Common.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unbroken.LaunchBox.Plugins">
			<HintPath>..\..\lib\launchbox\Unbroken.LaunchBox.Plugins.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.Extensions.DependencyInjection">
			<HintPath>..\..\lib\launchbox\Microsoft.Extensions.DependencyInjection.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
			<HintPath>..\..\lib\launchbox\Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="System.Private.Windows.Core">
			<HintPath>..\..\lib\launchbox\System.Private.Windows.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.Data.Sqlite">
			<HintPath>..\..\lib\launchbox\Microsoft.Data.Sqlite.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2">
			<Private>true</Private>
		</PackageReference>
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" ExcludeAssets="runtime" />
		<PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" ExcludeAssets="runtime" />
		<PackageReference Include="Riok.Mapperly" Version="5.0.0-next.8" />
	</ItemGroup>

	<Target Name="CopyAndDisguiseAssemblies" AfterTargets="CopyFilesToOutputDirectory">
		<ItemGroup>
			<TargetDlls Include="@(ReferencePath)" Condition="'%(FileName)' == 'iNKORE.UI.WPF' or '%(FileName)' == 'iNKORE.UI.WPF.Modern' or '%(FileName)' == 'iNKORE.UI.WPF.Modern.Controls'" />
		</ItemGroup>
		<Copy SourceFiles="@(TargetDlls)" DestinationFiles="@(TargetDlls->'$(TargetDir)%(FileName).dll.dep')" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<Resource Include="Resources\LogoBox.ico" />
		<Resource Include="Resources\LogoBox128px.png" />
		<Resource Include="Resources\rommIcon64px.ico" />
		<Resource Include="Resources\rommIcon64px.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="UI\Behaviours\" />
		<Folder Include="UI\Primitives\" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="call &quot;$(SolutionDir)\build\scripts\moveDebugBuild.bat&quot; &quot;$(ConfigurationName)&quot; &quot;$(SolutionDir)&quot; &quot;C:\Users\stigz\LaunchboxDEV\LaunchBox\Plugins\RommStar&quot; &quot;src\RommStar.Core\bin\Debug\net9.0-windows&quot;" />
	</Target>

</Project>