<Window x:Class="RommStar.Core.UI.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RommStar.Core.UI.Views"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:properties="clr-namespace:RommStar.Core.Properties"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        mc:Ignorable="d" d:Background="#202020" d:Foreground="Gainsboro" d:Width="600" d:Height="400"
        Icon="/RommStar.Core;component/Resources/rommIcon64px.ico"
        Height="{Binding Source={x:Static properties:Settings.Default},Path=WindowSize.Height}"
        Width="{Binding Source={x:Static properties:Settings.Default},Path=WindowSize.Width}"
        WindowStartupLocation="CenterScreen"
        Title="RommStar" Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources  AccentColor="#553e98" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <!--Your other resources here (if exists)-->
        </ResourceDictionary>
    </Window.Resources>

    <ui:NavigationView x:Name="NavigationView_Root" IsPaneOpen="False" SelectionChanged="NavigationView_SelectionChanged"
                       OpenPaneLength="147" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed">

        <ui:NavigationView.Resources>
            <Thickness x:Key="NavigationViewHeaderMargin">15,10,10,10</Thickness>
            <Thickness x:Key="NavigationViewContentMargin">5</Thickness>
        </ui:NavigationView.Resources>

        <ui:NavigationView.MenuItems>

            <ui:NavigationViewItem Content="Home" x:Name="NavigationViewItem_Home">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Home}" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem Content="Servers" x:Name="NavigationViewItem_Servers">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ServerSurfaceMultiple_16_Regular}" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem Content="Sync Jobs" x:Name="NavigationViewItem_Jobs">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DoubleSwipeDown_20_Regular}" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <ui:NavigationView.FooterMenuItems>

            <ui:NavigationViewItem Content="Settings" x:Name="NavigationViewItem_Settings">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Settings}" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem Content="About">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Info}" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem MouseLeftButtonUp="DarkModeToggle_MouseLeftButtonUp">

                <ui:NavigationViewItem.Content>
                    <ui:ToggleSwitch x:Name="DarkModeToggle" IsOn="{Binding IsDarkMode, Mode=TwoWay}" OnContent="" OffContent="" />
                </ui:NavigationViewItem.Content>
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WeatherMoon_20_Regular}" MouseLeftButtonUp="FontIcon_MouseLeftButtonUp" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <!--<ui:NavigationViewItem>
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WeatherMoon_20_Regular}" />
                    <ui:ToggleSwitch x:Name="DarkModeToggle" Margin="8,0,0,0" IsOn="{Binding IsDarkMode}" />
                </StackPanel>
            </ui:NavigationViewItem>-->
        </ui:NavigationView.FooterMenuItems>

        <ui:Frame x:Name="Frame_Main" />
    </ui:NavigationView>
</Window>