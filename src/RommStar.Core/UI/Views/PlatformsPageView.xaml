<Page x:Class="RommStar.Core.UI.Views.PlatformsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RommStar.Core.UI.Views"
      xmlns:vms="clr-namespace:RommStar.Core.UI.ViewModels"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:helpers="clr-namespace:RommStar.Core.UI.Helpers"
      xmlns:dtos="clr-namespace:RommStar.Core.Dtos"
      xmlns:converters="clr-namespace:RommStar.Core.UI.Converters"
      d:DataContext="{d:DesignInstance Type=vms:PlatformsPageVM, IsDesignTimeCreatable=True}"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Platforms">

    <Page.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- ================================================================ -->
            <!-- COLUMN 0: MASTER SIDEBAR                                         -->
            <!-- ================================================================ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Launchbox Platforms" Margin="0,0,0,10"
                           Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" />

                <TextBox Grid.Row="1"
                         ui:ControlHelper.PlaceholderText="Search Platforms..."
                         Margin="0,0,8,12"
                         HorizontalAlignment="Stretch" />

                <ListView Grid.Row="2"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding DisplayPlatforms}"
                          SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vms:MappedPlatformItemVM}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0"
                                        Background="#20FFFFFF" CornerRadius="4" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding LaunchboxPlatformName}"
                                           VerticalAlignment="Center"
                                           FontSize="14" Margin="0,0,10,0" />

                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#40808080" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                    <Setter Property="Background" Value="#40FF4D4D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding StoredRommPlatformIds.Count, StringFormat='{}{0} Mapped'}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                        <Setter Property="Text" Value="Orphaned" />
                                                        <Setter Property="Foreground" Value="#FF9999" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Grid.Row="3" FlowDirection="RightToLeft">
                    <Button Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                            Content="Sync All Platforms"
                            Padding="16,8" Margin="0,0,10,0" />
                    <Button Padding="16,8"
                            ToolTip="Refresh LaunchBox Platforms Catalog"
                            Command="{Binding RefreshLaunchboxPlatformsCommand}">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================================================================ -->
            <!-- COLUMN 1: SPLITTER                                               -->
            <!-- ================================================================ -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ================================================================ -->
            <!-- COLUMN 2: DETAIL PANEL                                           -->
            <!-- ================================================================ -->
            <Grid Grid.Column="2" Margin="12,0,0,0">

                <TextBlock Text="Select a LaunchBox platform."
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Romm Platforms Map" Margin="0,0,0,10"
                               Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" />

                    <Border Grid.Row="1" Background="#20000000" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPlatform.LaunchboxPlatformName}"
                                       FontWeight="SemiBold" Margin="0,0,0,16" />

                            <!-- Server Selection -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target RomM Server:" VerticalAlignment="Center"
                                           Margin="0,0,12,0" FontWeight="SemiBold" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableServers}"
                                          SelectedItem="{Binding SelectedPlatform.AssignedServer, Mode=TwoWay}"
                                          DisplayMemberPath="ServerName"
                                          ui:ControlHelper.PlaceholderText="Select target server context..." />
                                <Button Grid.Column="2" Margin="8,0,0,0" ToolTip="Refresh RomM Server Platforms"
                                        Command="{Binding RefreshServerPlatformsCommand}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
                                </Button>
                            </Grid>

                            <!-- Platform Picker DropDown -->
                            <TextBlock Text="Mapping Definitions" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <ToggleButton x:Name="AddPlatformToggle"
                                                  Content="+ Add RomM Platform"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,0,16" />

                            <Popup x:Name="PlatformPickerPopup"
                                   PlacementTarget="{Binding ElementName=AddPlatformToggle}"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsChecked, ElementName=AddPlatformToggle, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="False"
                                   PopupAnimation="Slide"
                                   Opened="PlatformPickerPopup_Opened">
                                <!--
        AllowsTransparency="False" = hardware-composited HWND, GPU rendered.
        No DropShadowEffect = no software render-target switch.
        Simulated depth via BorderThickness offset border instead.
    -->
                                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="1"
                                        Padding="4">
                                    <ListView x:Name="PlatformPickerListView"
                                                Width="380"
                                                Height="300"
                                                ItemsSource="{Binding CurrentServerAvailablePlatforms}"
                                                SelectionMode="Multiple"
                                                ScrollViewer.CanContentScroll="True"
                                                VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.VirtualizationMode="Recycling"
                                                SelectionChanged="PlatformPickerListView_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate DataType="{x:Type dtos:RommPlatformDTO}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding RommName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Slug}" FontSize="11" Foreground="#80FFFFFF" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                                Text="{Binding RomCount, StringFormat='{}{0} Roms'}"
                                                                FontSize="12" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Margin="16,0,0,0" Opacity="0.4" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Popup>

                            <!-- Mapped Platform Capsule Tokens -->
                            <ItemsControl ItemsSource="{Binding SelectedPlatform.MappedRommPlatforms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dtos:RommPlatformDTO}">
                                        <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                CornerRadius="14" Padding="10,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RommName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <!-- x:Name not needed here; DataContext carries the DTO via button.DataContext -->
                                                <Button Content="✕"
                                                        Padding="0" Width="16" Height="16"
                                                        Background="Transparent" BorderThickness="0"
                                                        FontSize="10" VerticalAlignment="Center" Opacity="0.6"
                                                        Click="RemovePlatformButton_Click" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Expander Grid.Row="2" Header="Advanced Settings"
                              HorizontalAlignment="Stretch" Margin="0,12,0,12">
                        <Grid>
                            <TextBlock Text="Placeholder for upcoming scraping overrides and folder structures."
                                       Foreground="#80FFFFFF" FontStyle="Italic" />
                        </Grid>
                    </Expander>

                    <Button Grid.Row="3"
                            Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                            Content="Sync Platform Now"
                            HorizontalAlignment="Right"
                            Padding="16,8"
                            Margin="12,0,0,0"
                            IsEnabled="{Binding SelectedPlatform, Converter={StaticResource NullToBoolConverter}}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>