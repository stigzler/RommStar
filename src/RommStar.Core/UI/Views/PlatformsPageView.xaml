<Page x:Class="RommStar.Core.UI.Views.PlatformsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RommStar.Core.UI.Views"
      xmlns:vms="clr-namespace:RommStar.Core.UI.ViewModels"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:helpers="clr-namespace:RommStar.Core.UI.Helpers"
      xmlns:dtos="clr-namespace:RommStar.Core.Dtos"
      xmlns:converters="clr-namespace:RommStar.Core.UI.Converters"
      d:DataContext="{d:DesignInstance Type=vms:PlatformsPageVM, IsDesignTimeCreatable=True}"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Platforms">

    <Page.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Row 0: Global Universal Title & Top Header -->
            <!--<RowDefinition Height="Auto" />-->
            <!-- Row 1: Main Moveable Master/Detail Workspace Split -->
            <RowDefinition Height="*" />
            <!-- Row 2: Symmetric Operational Execution Baseline -->
            <!--<RowDefinition Height="Auto" />-->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- GLOBAL TOP HEADER ROW                                                     -->
        <!-- ========================================================================= -->
        <!--<StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
        </StackPanel>-->

        <!-- ========================================================================= -->
        <!-- MOVEABLE MASTER / DETAIL MAIN WORKSPACE GRID                              -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Localized Master Sidebar Column -->
                <ColumnDefinition Width="1*" MinWidth="250" />
                <!-- Column 1: Resizable Movable GridSplitter Column -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 2: Contextual Detail Workspace Column -->
                <ColumnDefinition Width="2*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
            <!-- COLUMN 0: LOCALIZED MASTER SIDEBAR                                    -->
            <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Localized Search Box -->
                    <RowDefinition Height="Auto" />
                    <!-- Localized Search Box -->
                    <RowDefinition Height="*" />
                    <!-- Scrollable ListView -->
                    <RowDefinition Height="Auto" />
                    <!-- Sync All PLatforms Button -->
                </Grid.RowDefinitions>

                <!-- Column Header-->
                <TextBlock Grid.Row="0" Text="Launchbox Platforms" Margin="0,0,0,10" Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" />

                <!-- Isolated Search Input Box Card -->
                <TextBox Grid.Row="1"
                             ui:ControlHelper.PlaceholderText="Search Platforms..."
                             Margin="0,0,8,12"
                             HorizontalAlignment="Stretch" />

                <!-- Master Platform Selection List -->
                <ListView Grid.Row="2"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding DisplayPlatforms}"
                          SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vms:MappedPlatformItemVM}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Icon Space -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Name & Status -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Badge Token -->
                                </Grid.ColumnDefinitions>

                                <!-- Placeholder for your future platform icon resolution hook -->
                                <Border Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0"
                                        Background="#20FFFFFF" CornerRadius="4" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding LaunchboxPlatformName}"
                                           VerticalAlignment="Center"
                                           FontSize="14" Margin="0,0,10,0" />

                                <!-- Indicator State Badges (Orphan vs. Mapped Counts) -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#40808080" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                    <Setter Property="Background" Value="#40FF4D4D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding StoredRommPlatformIds.Count, StringFormat='{}{0} Mapped'}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                        <Setter Property="Text" Value="Orphaned" />
                                                        <Setter Property="Foreground" Value="#FF9999" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Grid.Row="3" FlowDirection="RightToLeft">
                    <Button Grid.Row="3" Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                             Content="Sync All Platforms"
                             Padding="16,8" Margin="0,0,10,0" />
                    <Button  Padding="16,8"
                            ToolTip="Refresh LaunchBox Platforms Catalog"
                            Command="{Binding RefreshLaunchboxPlatformsCommand}">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
            <!-- COLUMN 1: MOVEABLE SPLITTER                                           -->
            <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
            <!-- COLUMN 2: CONTEXTUAL DETAIL WORKSPACE PANEL                           -->
            <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <!-- Fallback view context placeholder when nothing is highlighted inside left sidebar -->
                <TextBlock Text="Select a LaunchBox platform."
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.6" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Core Workstation Content Framework -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <!-- Header -->
                        <RowDefinition Height="*" />
                        <!-- Configuration Canvas Card Space -->
                        <RowDefinition Height="Auto" />
                        <!-- Advanced Settings Expander Spacer -->
                        <RowDefinition Height="auto" />
                        <!-- Bottom Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Romm Platforms Map" Margin="0,0,0,10" Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" />

                    <!-- Background Translucent Base Workspace Canvas Card Frame -->
                    <Border Grid.Row="1" Background="#20000000" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <!-- Header Row Content: LaunchBox Name -->
                            <TextBlock Text="{Binding SelectedPlatform.LaunchboxPlatformName}"
                                        FontWeight="SemiBold" Margin="0,0,0,16" />

                            <!-- Server Context Selection Line Strip Layout -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target RomM Server:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableServers}"
                                          SelectedItem="{Binding SelectedPlatform.AssignedServer, Mode=TwoWay}"
                                          DisplayMemberPath="ServerName"
                                          ui:ControlHelper.PlaceholderText="Select target server context..." />
                                <Button Grid.Column="2" Margin="8,0,0,0" ToolTip="Refresh RomM Server Platforms"
                                        Command="{Binding RefreshServerPlatformsCommand}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
                                </Button>
                            </Grid>

                            <!-- Data Entry Action: Clean DropDownButton Insertion Layer -->
                            <TextBlock Text="Mapping Definitions" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <ui:DropDownButton Content="+ Add RomM Platform"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,16">
                                <ui:DropDownButton.Flyout>
                                    <ui:Flyout Placement="Bottom">
                                        <!-- Interactive pop-out scrolling list targeting rich DTO boundaries -->
                                        <ListView Width="350" MaxHeight="300"
                                                  ItemsSource="{Binding CurrentServerAvailablePlatforms}"
                                                  SelectionMode="Multiple">
                                            <!-- We bind the selection event via interaction behaviors to invoke VM methods -->
                                            <ListView.ItemTemplate>
                                                <DataTemplate DataType="{x:Type dtos:RommPlatformDTO}">
                                                    <Grid Margin="0,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding RommName}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Slug}" FontSize="11" Foreground="#80FFFFFF" />

                                                        <!-- Category Metadata Indicators (E.g. Console vs Arcade vs Computer) -->
                                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Top"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding RomCount, StringFormat='{}{0} Roms'}" FontSize="12" HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" Opacity="0.4" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </ui:Flyout>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>

                            <!-- Active Platform Mapping Tokens / Capsule Wrapping Workspace -->
                            <ItemsControl ItemsSource="{Binding SelectedPlatform.MappedRommPlatforms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dtos:RommPlatformDTO}">
                                        <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                CornerRadius="14" Padding="10,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RommName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <!-- Action tag closure anchor -->
                                                <Button Content="✕" Padding="0" Width="16" Height="16" Background="Transparent" BorderThickness="0"
                                                        FontSize="10" VerticalAlignment="Center" Opacity="0.6" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Baseline Nested Expandable Advanced Configurations Layer -->
                    <Expander Grid.Row="2" Header="Advanced Settings"
                                HorizontalAlignment="Stretch" Margin="0,12,0,12">
                        <Grid>
                            <TextBlock Text="Placeholder for upcoming scraping overrides and folder structures." Foreground="#80FFFFFF" FontStyle="Italic" />
                        </Grid>
                    </Expander>

                    <!-- Sync Isolated Context Anchor Button Bar -->
                    <Button Grid.Row="3" Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                    Content="Sync Platform Now"
                    HorizontalAlignment="Right"
                    Padding="16,8"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding SelectedPlatform, Converter={StaticResource NullToBoolConverter}}">
                        <!-- Bound to the eventual specific syncing platform job command routine execution -->
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- SYMMETRIC OPERATIONAL EXECUTION BASELINE                                  -->
        <!-- ========================================================================= -->
        <!--<Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                -->
        <!-- Aligns left baseline perfectly with the Left Sidebar Grid boundary -->
        <!--
                <ColumnDefinition Width="1*" MinWidth="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            -->
        <!-- Sync All Actions Anchor Button Bar -->
        <!--
            <Button Grid.Column="0" Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                    Content="Sync All Platforms"
                    HorizontalAlignment="Left"
                    Padding="16,8" />

            -->
        <!-- Sync Isolated Context Anchor Button Bar -->
        <!--
            <Button Grid.Column="2" Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                    Content="Sync Platform Now"
                    HorizontalAlignment="Left"
                    Padding="16,8"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding SelectedPlatform, Converter={StaticResource NullToBoolConverter}}">
                -->
        <!-- Bound to the eventual specific syncing platform job command routine execution -->
        <!--
            </Button>
        </Grid>-->
    </Grid>
</Page>