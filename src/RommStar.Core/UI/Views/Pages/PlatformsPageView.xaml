<Page x:Class="RommStar.Core.UI.Views.PlatformsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RommStar.Core.UI.Views"
      xmlns:vms="clr-namespace:RommStar.Core.UI.ViewModels"
      xmlns:vmsd="clr-namespace:RommStar.Core.UI.ViewModels.DataModels"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:helpers="clr-namespace:RommStar.Core.UI.Helpers"
      xmlns:dtos="clr-namespace:RommStar.Core.Dtos"
      xmlns:converters="clr-namespace:RommStar.Core.UI.Converters"
      d:DataContext="{d:DesignInstance Type=vms:PlatformsPageVM, IsDesignTimeCreatable=True}"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Platforms" IsVisibleChanged="Page_IsVisibleChanged">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InfoBarSeverityToHexColorConverter x:Key="InfoBarSeverityToHexColorConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =============== TOP BUTTONS ===================== -->

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Test" Command="{Binding TestCommand}" />
            </StackPanel>
        </Grid>

        <!-- =============== MAIN CONTORLS ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- Launchbox Platforms Column -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Launchbox Platforms" Margin="0,0,0,10"
                           Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" />

                <!-- Search Box -->
                <ui:AutoSuggestBox Grid.Row="1"
                         ui:ControlHelper.PlaceholderText="Search Platforms..."
                         Margin="0,0,8,12"
                         HorizontalAlignment="Stretch" ItemsSource="{Binding LaunchboxPlatformItems}"
                                   DisplayMemberPath="LaunchboxPlatformName" TextMemberPath="LaunchboxPlatformName">
                    <ui:AutoSuggestBox.QueryIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                    </ui:AutoSuggestBox.QueryIcon>
                </ui:AutoSuggestBox>

                <ListView Grid.Row="2"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding LaunchboxPlatformItems}"
                          SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vmsd:LaunchboxPlatformItemVM}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0"
                                       Source="{Binding IconPath}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding LaunchboxPlatformName}"
                                           VerticalAlignment="Center"
                                           FontSize="14" Margin="0,0,10,0" />

                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    ToolTip="This Platform no longer exists in Launchbox">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#40808080" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                    <Setter Property="Background" Value="#40FF4D4D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding MatchedRommPlatformCount, StringFormat='{}{0} Mapped'}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                            <Setter Property="Text" Value="Orphaned" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOrphaned}" Value="False">
                                                            <Setter Property="Text" Value="{Binding MappedRommPlatformsCount}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Setter Property="ToolTip" Value="Number of mapped Romm Platforms" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Padding="5,1,5,0" Background="Transparent" BorderThickness="0" ToolTip="Delete Map"
                                            Command="{Binding DeleteOrphanCommand}" Visibility="{Binding IsOrphaned, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Grid.Row="3" FlowDirection="RightToLeft">
                    <Button Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                            Content="Sync All Platforms"
                            Padding="16,8" Margin="0,0,10,0" />
                    <Button Padding="16,8"
                            ToolTip="Refresh LaunchBox Platforms Catalog"
                            Command="{Binding ReloadLaunchboxPlatformsCommand}">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Detail View -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Placeholder when no Platform Selected -->
                <TextBlock Text="Select a LaunchBox platform."
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Main Details View -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Heading -->
                    <TextBlock Grid.Row="0" Text="Romm Platforms Map" Margin="0,0,0,10"
                               Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" />

                    <!-- Mapping Panel -->
                    <Border Grid.Row="1" Background="#20000000" CornerRadius="14" Padding="20">
                        <StackPanel>

                            <!-- Selected Platform Name Text -->
                            <StackPanel  Grid.Column="0" Orientation="Horizontal">
                                <Image  Width="24" Height="24" Margin="0,0,12,0"
                                      Source="{Binding SelectedPlatform.IconPath}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedPlatform.LaunchboxPlatformName}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Server Selection -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Ellipse Grid.Column="0" Grid.Row="1" Width="14" Height="14" StrokeThickness="1" Stroke="#a0000000"
                                         Fill="{Binding SelectedPlatform.AssignedServerItem.InfoBar.Severity, Converter={StaticResource InfoBarSeverityToHexColorConverter}}"
                                         VerticalAlignment="Center" Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1" Grid.Row="1" Text="Target RomM Server:" VerticalAlignment="Center"
                                           Margin="0,0,12,0" FontWeight="SemiBold" />

                                <ComboBox x:Name="RommServerCombobox" Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding RommServerItems}"
                                          SelectedItem="{Binding SelectedPlatform.AssignedServerItem, Mode=TwoWay}"
                                          DisplayMemberPath="RommServer.ServerName"
                                          ui:ControlHelper.PlaceholderText="Select target server context..." />

                                <Button Grid.Column="3" Grid.Row="1"  Margin="8,0,0,0" ToolTip="Refresh RomM Server Platforms"
                                        Command="{Binding RefreshRommServerPlatformsCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=RommServerCombobox}">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                                </Button>
                            </Grid>
                            <!-- Server Info Bar (Vis toggles) -->
                            <ui:InfoBar IsClosable="True" IsIconVisible="True" Grid.ColumnSpan="3"
                                            IsOpen="{Binding SelectedPlatform.AssignedServerItem.InfoBar.IsOpen, Mode=TwoWay}"
                                            Severity="{Binding SelectedPlatform.AssignedServerItem.InfoBar.Severity}"
                                            Title="{Binding SelectedPlatform.AssignedServerItem.InfoBar.Title}"
                                            Message="{Binding SelectedPlatform.AssignedServerItem.InfoBar.Message}" />

                            <!-- Search Box -->
                            <ComboBox ItemsSource="{Binding SelectedRommServer.ServerPlatformDTOs}"
                                      DisplayMemberPath="RommName" Width="400"
                                      VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizing="True" />

                            <!--<ui:AutoSuggestBox
                                    ui:ControlHelper.PlaceholderText="Search Romm Platforms..."
                                    HorizontalAlignment="Stretch" ItemsSource="{Binding SelectedRommServer.ServerPlatformDTOs}"
                                  DisplayMemberPath="RommName" TextMemberPath="RommName">
                                <ui:AutoSuggestBox.QueryIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                                </ui:AutoSuggestBox.QueryIcon>
                            </ui:AutoSuggestBox>-->
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>