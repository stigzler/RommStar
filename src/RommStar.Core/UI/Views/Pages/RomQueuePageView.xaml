<ui:Page x:Class="RommStar.Core.UI.Views.Pages.RomQueuePageView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:RommStar.Core.UI.Views.Pages"
         xmlns:vms="clr-namespace:RommStar.Core.UI.ViewModels.Pages"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
         xmlns:converters="clr-namespace:RommStar.Core.UI.Converters"
         xmlns:sys="clr-namespace:System;assembly=mscorlib"
         xmlns:sync="clr-namespace:RommStar.Core.Sync"         
         d:DataContext="{d:DesignInstance Type=vms:RomQueuePageVM, IsDesignTimeCreatable=True}"
         mc:Ignorable="d"
         d:DesignHeight="450" d:DesignWidth="800"
         Title="Download Jobs"
         TextOptions.TextFormattingMode="Display"
         TextOptions.TextRenderingMode="ClearType"
         UseLayoutRounding="True"
         SnapsToDevicePixels="True"
         x:Name="RomQueuePage">

    <ui:Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:XamlControlsResources />
                <ui:ThemeResources AccentColor="#553e98" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BytesToFormattedConverter x:Key="BytesToFormattedConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </ui:Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- Main List -->
        <Border Grid.Row="1" Background="#20000000" CornerRadius="14" Margin="0,0,8,10">

            <Grid>

                <ListView ItemsSource="{Binding GroupedQueueView}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionMode="Single"
                      BorderThickness="0"
                      Background="Transparent"
                      Margin="0,5,0,0">

                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <CornerRadius x:Key="ListViewItemCornerRadius">4</CornerRadius>
                        <sys:Boolean x:Key="UseSystemFocusVisuals">True</sys:Boolean>
                    </ListView.Resources>

                    <!-- THE INTERACTIVE COLLAPSIBLE GROUP HEADERS -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">

                                                <!-- Wrap the whole group in an Expander -->
                                                <Expander IsExpanded="False" HorizontalContentAlignment="Stretch" Margin="10,5,20,5">

                                                    <!-- The Header Bar -->
                                                    <Expander.Header>
                                                        <Grid HorizontalAlignment="Stretch" Margin="0,5,15,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                                                                <TextBlock Text="{Binding ItemCount, StringFormat='{} ({0} items)'}" 
                                                                       Opacity="0.6" FontSize="14" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Clear Platform Button -->
                                                            <Button Grid.Column="1" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                                ToolTip="Clear all queued items for this platform"
                                                                Command="{Binding DataContext.ClearPlatformCommand, ElementName=RomQueuePage}"
                                                                CommandParameter="{Binding Name}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="14" Margin="0,0,5,0" Foreground="#FF4D4D" />
                                                                    <TextBlock Text="Clear" Foreground="#FF4D4D" FontSize="12" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Expander.Header>

                                                    <!-- The child items (Games) are rendered here when expanded -->
                                                    <Expander.Content>
                                                        <ItemsPresenter Margin="0,5,0,5" />
                                                    </Expander.Content>

                                                </Expander>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="{StaticResource ListViewItemBackground}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="10,2,20,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <!-- THE TWO-ROW DATA TEMPLATE -->
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type sync:RomQueueItem}">
                            <StackPanel Orientation="Vertical">

                                <!-- BLOCK 1: MAIN DATA ROW -->
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <!-- Name -->
                                        <ColumnDefinition Width="1.5*" />
                                        <!-- Added & Status -->
                                        <ColumnDefinition Width="1*" />
                                        <!-- Size -->
                                        <ColumnDefinition Width="1.5*" />
                                        <!-- Badges -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Quarantine Toggle -->
                                        <ColumnDefinition Width="40" />
                                        <!-- Delete -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Opacity Wrapper for Main Data (Excludes Toggle/Delete buttons) -->
                                    <Grid Grid.ColumnSpan="4">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQuarantined}" Value="True">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Game Name -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding GameNameSanitised}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Added At & Live Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding AddedAt, StringFormat='{}{0:dd/MM/yy HH:mm}'}" FontSize="11" Opacity="0.6" />
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.AccentAAFillColorDefaultBrushKey}}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="2" Text="{Binding TotalSizeBytes, Converter={StaticResource BytesToFormattedConverter}}" 
                                               VerticalAlignment="Center" Opacity="0.8" />

                                        <!-- Badges Panel -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

                                            <Border Background="#20808080" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                Visibility="{Binding IsSingleFileGame, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Single-file Game">
                                                <TextBlock Text="Single-File" FontSize="11" Opacity="0.8" />
                                            </Border>

                                            <Border Background="#20808080" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                Visibility="{Binding IsMultiFileGame, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Multi-file Game">
                                                <TextBlock Text="Multi-File" FontSize="11" Opacity="0.8" />
                                            </Border>

                                            <Border Background="#20808080" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                Visibility="{Binding IsSiblingSet, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Sibling Set (Multiple Versions)">
                                                <TextBlock Text="Sibling Set" FontSize="11" Opacity="0.8" />
                                            </Border>

                                            <Border Background="#40FF9900" CornerRadius="4" Padding="6,2" ToolTip="Download Retries">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RetryCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RetryCount, StringFormat='{}Retries: {0}'}" FontSize="11" FontWeight="Bold" Foreground="red" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>


                                    <!-- Quarantine Status & Resume Button -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <TextBlock Text="Quarantined" Foreground="red" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                               ToolTip="Items are Quarantined when the install process fails to complete for the game . It is then excluded from future syncs until unquarantined. Do this after addressing the underlying problem."/>

                                        <Button ToolTip="Resume download (Un-quarantine)" 
                                            Command="{Binding DataContext.ToggleQuarantineCommand, ElementName=RomQueuePage}"
                                            CommandParameter="{Binding .}"
                                            Padding="6,4" Background="Transparent" BorderThickness="1" BorderBrush="#40808080">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" FontSize="12" Margin="0,0,4,0" Foreground="{DynamicResource {x:Static ui:ThemeKeys.AccentAAFillColorDefaultBrushKey}}"/>
                                                <TextBlock Text="Unquarantine" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="4"
                                        ToolTip="Remove from queue" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.RemoveItemCommand, ElementName=RomQueuePage}"
                                        CommandParameter="{Binding .}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <!-- Disable the button by default for all active downloading/extracting states -->
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Style.Triggers>

                                                    <!-- Enable if it hasn't started yet -->
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:RomQueueItemStatus.Queued}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </DataTrigger>

                                                    <!-- Enable if it failed, so the user can clear the error from the screen -->
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:RomQueueItemStatus.Errored}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </DataTrigger>

                                                    <!-- Enable if it finished with warnings, so the user can dismiss it -->
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:RomQueueItemStatus.CompleteWithWarnings}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="16" Opacity="0.6"/>
                                    </Button>

                                </Grid>

                                <!-- BLOCK 2: THE ERROR TRAY -->
                                <Border Background="#1AEE1111" CornerRadius="0,0,4,4" Padding="12,6" Margin="12,0,12,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- Changed from StackPanel to Grid to force text wrapping -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ui:FontIcon Grid.Column="0" Icon="{x:Static ui:SegoeFluentIcons.Warning}" Foreground="#FF4D4D" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LastError}" Foreground="#FF4D4D" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- EMPTY STATE OVERLAY -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding GroupedQueueView.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">

                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Download}" 
                         FontSize="48" 
                         Opacity="0.3" 
                         HorizontalAlignment="Center" 
                         Margin="0,0,0,15"
                         TextOptions.TextFormattingMode="Ideal"
                         TextOptions.TextRenderingMode="Auto" />

                    <TextBlock Text="Download Queue is empty" FontSize="18" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Center"/>
                    <TextBlock Text="Games are queued for download will appear here." FontSize="14" Opacity="0.4" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                </StackPanel>


            </Grid>






        </Border>
    </Grid>
</ui:Page>