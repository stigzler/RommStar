<Page x:Class="RommStar.Core.UI.Views.Pages.JobsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RommStar.Core.UI.Views"
      xmlns:vm="clr-namespace:RommStar.Core.UI.ViewModels"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"

      d:DataContext="{d:DesignInstance Type=vm:JobsPageVM, IsDesignTimeCreatable=True}"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Sync Jobs">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- e.g., Title Header -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="Start Test Jobs" Command="{Binding StartSyncJobCommand}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource DefaultScrollViewerStyle}">
            <ItemsControl ItemsSource="{Binding ActiveJobs}" Padding="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- A standard WPF Border that looks up iNKORE colors at runtime -->
                        <Border x:Name="JobCard"
                                Margin="0,0,16,12"
                                Padding="16"
                                BorderThickness="1"
                                CornerRadius="12"
                                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                BorderBrush="{DynamicResource SystemControlCornerRadiusBrush}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <WrapPanel>
                                        <!-- Text colors automatically invert from black to white based on theme -->
                                        <TextBlock Text="{Binding LaunchBoxPlatformName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />

                                        <TextBlock Text="{Binding Status, StringFormat=' - \{0\}'}"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12" />
                                    </WrapPanel>

                                    <!-- Native ProgressBar automatically tints to your iNKORE window accent color -->
                                    <ui:ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="1" Background="#80808080"
                                                 Margin="0,10,0,0" Foreground="Green" MinHeight="5">
                                    </ui:ProgressBar>

                                    <TextBlock Text="{Binding ProcessedItems, StringFormat='Files Processed: \{0\}'}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontSize="11"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Margin="16,0,0,0"
                                    Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding Id}">

                                    <!-- ToolTip layout helper for enhanced accessibility feedback states -->
                                    <Button.ToolTip>
                                        <ToolTip Content="Cancel Sync Task" />
                                    </Button.ToolTip>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Dynamic Color Triggers that switch safely for Light & Dark Modes -->
                        <DataTemplate.Triggers>
                            <!-- 1. Syncing Files State: Green variants -->
                            <DataTrigger Binding="{Binding Status}" Value="SyncingFiles">
                                <Setter TargetName="JobCard" Property="Background" Value="#80553e98" />
                                <Setter TargetName="JobCard" Property="BorderBrush" Value="#80371f69" />
                            </DataTrigger>

                            <!-- 2. Queued State: Muted Gray variants -->
                            <DataTrigger Binding="{Binding Status}" Value="Queued">
                                <Setter TargetName="JobCard" Property="Background" Value="#80424242" />
                                <Setter TargetName="JobCard" Property="BorderBrush" Value="#802D2D2D" />
                            </DataTrigger>

                            <!-- 3. Completed State: Green -->
                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                <Setter TargetName="JobCard" Property="Background" Value="#40408040" />
                                <Setter TargetName="JobCard" Property="BorderBrush" Value="#808080" />
                            </DataTrigger>

                            <!-- 4. Cancelled State: Red -->
                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                <Setter TargetName="JobCard" Property="Background" Value="#40ff0000" />
                                <Setter TargetName="JobCard" Property="BorderBrush" Value="#808080" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>