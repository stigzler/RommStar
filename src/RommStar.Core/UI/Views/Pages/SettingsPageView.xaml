<ui:Page x:Class="RommStar.Core.UI.Views.Pages.SettingsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RommStar.Core.UI.Views.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:vm="clr-namespace:RommStar.Core.UI.ViewModels.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:sync="clr-namespace:RommStar.Core.Sync"
      xmlns:converters="clr-namespace:RommStar.Core.UI.Converters"
      xmlns:ucs="clr-namespace:RommStar.Core.UI.Views.UserControls"
        xmlns:prims="clr-namespace:RommStar.Core.Primitives"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SettingsPageVM, IsDesignTimeCreatable=True}"
      d:DesignHeight="450" d:DesignWidth="800" d:Background="#202020" d:Foreground="Gainsboro"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      IsVisibleChanged="Page_IsVisibleChanged"
      Title="Settings">

    <ui:Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:XamlControlsResources />
                <ui:ThemeResources AccentColor="#553e98" />
            </ResourceDictionary.MergedDictionaries>

            <converters:SyncProfileConverter x:Key="SyncProfileConverter" />

            <ObjectDataProvider x:Key="SyncProfileEnum"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="sync:SyncProfileTypes" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="LogLevelEnum"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="prims:LoggingLevel" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>
    </ui:Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                    Command="{Binding SaveSettingsCommand}" FontWeight="DemiBold"
                     BorderBrush="#80000000" BorderThickness="1" Padding="16,8">
                <StackPanel Orientation="Horizontal" >
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Save_20_Regular}" FontSize="20" Margin="0,2,5,0" />
                    <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,20,10">

                <TextBlock Text="Global Settings" Style="{StaticResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" Margin="0,0,0,10"/>

                <ui:SettingsCard Header="Youtube Stub" Description="Prefix text used to construct the final youtube url from the RomM video key"  >
                    <TextBox Text="{Binding PluginSettings.YouTubeStub, Mode=TwoWay}"/>
                </ui:SettingsCard>

                <ui:SettingsExpander Header="Logging Settings" 
                                     Description="Shape the outpur logs for RomMStar"
                                     Margin="0,10,0,0"
                                     IsExpanded="False" Visibility="Visible">
                    <ui:SettingsExpander.Items>

                        <ui:SettingsCard Header="Log Level" Description="Level of detail in log."  >
                            <ComboBox ItemsSource="{Binding Source={StaticResource LogLevelEnum}}"
                              SelectedItem="{Binding PluginSettings.LoggingLevel, Mode=TwoWay}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="Redact Sensitive Data in Log" Description="Will not include any personally identifiable information like Romm API URLs, etc"  >
                            <ui:ToggleSwitch IsOn="{Binding PluginSettings.LoggingRedact, Mode=TwoWay}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="Include Calling Member" Description="Will include the class and method the logging was called from"  >
                            <ui:ToggleSwitch IsOn="{Binding PluginSettings.LoggingIncludeMember, Mode=TwoWay}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="Prepend Calling Member" Description="Will put the calling member at the start of the log entry instead of at the end."  >
                            <ui:ToggleSwitch IsOn="{Binding PluginSettings.LoggingPrependMember, Mode=TwoWay}"/>
                        </ui:SettingsCard>

                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <ui:SettingsExpander Header="Rom Install Media Download Profile" 
                                     Description="Select which media items to download when a game's rom is installed"
                                     Margin="0,10,0,0"
                                     IsExpanded="False" Visibility="Collapsed">
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding InstallMediaTypes}" Margin="5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ucs:MediaSelectionItemViewModel}">
                                        <CheckBox Content="{Binding DisplayName}" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              Margin="5,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <ui:SettingsExpander Header="Media Download Profile" 
                                     Description="Select which media items to pull automatically during a platform synchronization"
                                     Margin="0,10,0,0"
                                     IsExpanded="False">
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding SyncMediaTypes}" Margin="5" >
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ucs:MediaSelectionItemViewModel}">
                                        <CheckBox Content="{Binding DisplayName}" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              Margin="5,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>


                <TextBlock Text="Global Sync Settings" Style="{StaticResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}" Margin="0,10,0,10"/>

                <Border Background="#20000000" Padding="10" CornerRadius="10"> 
                    <ucs:ExtendedSyncSettingsView ExtendedSyncSettings="{Binding PluginSettings.GlobalExtendedSyncSettings, Mode=TwoWay}"/>
                </Border>

            </StackPanel>

        </ScrollViewer>
    </Grid>


</ui:Page>