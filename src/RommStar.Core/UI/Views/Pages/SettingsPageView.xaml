<ui:Page x:Class="RommStar.Core.UI.Views.Pages.SettingsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RommStar.Core.UI.Views.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:vm="clr-namespace:RommStar.Core.UI.ViewModels"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:sync="clr-namespace:RommStar.Core.Sync"
      xmlns:converters="clr-namespace:RommStar.Core.UI.Converters"
      xmlns:ucs="clr-namespace:RommStar.Core.UI.Views.UserControls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:Pages.SettingsPageVM, IsDesignTimeCreatable=True}"
      d:DesignHeight="450" d:DesignWidth="800" d:Background="#202020" d:Foreground="Gainsboro"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      IsVisibleChanged="Page_IsVisibleChanged"
      Title="Settings">

    <ui:Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:XamlControlsResources />
                <ui:ThemeResources AccentColor="#553e98" />
            </ResourceDictionary.MergedDictionaries>

            <converters:SyncProfileConverter x:Key="SyncProfileConverter" />

            <ObjectDataProvider x:Key="SyncProfileEnum"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="sync:SyncProfileTypes" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </ui:Page.Resources>

    <TabControl ui:TabControlHelper.IsAddTabButtonVisible="False" Style="{StaticResource TabControlPivotStyle}">

        <TabItem Header="Sync Settings" ui:TabItemHelper.IsClosable="False">

            <ui:TabItemHelper.Icon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DoubleSwipeDown_20_Regular}" />
            </ui:TabItemHelper.Icon>

            <ScrollViewer>
                <StackPanel Margin="0,10,20,10">

                    <ui:SettingsCard Header="Youtube Stub" Description="Prefix text used to construct the final youtube url from the RomM video key"  >
                        <TextBox Text="{Binding PluginSettings.YouTubeStub, Mode=TwoWay}"/>
                    </ui:SettingsCard>


                    <ucs:ExtendedSyncSettingsView ExtendedSyncSettings="{Binding PluginSettings.GlobalExtendedSyncSettings, Mode=TwoWay}"/>

                    <ui:SettingsExpander Header="Sync Media Download Profile" 
                                     Description="Select which media items to pull automatically during a platform synchronization"
                                     Margin="0,10,0,0"
                                     IsExpanded="False">
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{Binding SyncMediaTypes}" Margin="5" >
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ucs:MediaSelectionItemViewModel}">
                                            <CheckBox Content="{Binding DisplayName}" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              Margin="5,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <ui:SettingsExpander Header="Rom Install Media Download Profile" 
                                     Description="Select which media items to download when a game's rom is installed"
                                     Margin="0,10,0,0"
                                     IsExpanded="False" Visibility="Collapsed">

                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{Binding InstallMediaTypes}" Margin="5">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ucs:MediaSelectionItemViewModel}">
                                            <CheckBox Content="{Binding DisplayName}" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              Margin="5,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- APPLICATION SETTINGS -->
        <TabItem Header="Application" ui:TabItemHelper.IsClosable="False">
            <ui:TabItemHelper.Icon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AppGeneric_20_Regular}" />
            </ui:TabItemHelper.Icon>
            <Grid Margin="10">
            </Grid>
        </TabItem>

        <TabItem Header="TabItem 3">
            <TextBlock Text="Content 3" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </TabItem>
    </TabControl>
</ui:Page>