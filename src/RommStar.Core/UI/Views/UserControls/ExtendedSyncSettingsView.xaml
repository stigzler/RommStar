<UserControl x:Class="RommStar.Core.UI.Views.UserControls.ExtendedSyncSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RommStar.Core.UI.Views.UserControls"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
            xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
            xmlns:vm="clr-namespace:RommStar.Core.UI.ViewModels"
            xmlns:sys="clr-namespace:System;assembly=mscorlib"
            xmlns:sync="clr-namespace:RommStar.Core.Sync"
             xmlns:prims="clr-namespace:RommStar.Core.Primitives"
            xmlns:converters="clr-namespace:RommStar.Core.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:XamlControlsResources />
                <ui:ThemeResources AccentColor="#553e98" />
            </ResourceDictionary.MergedDictionaries>

            <converters:SyncProfileConverter x:Key="SyncProfileConverter" />
            <converters:ByteToGigabyteConverter x:Key="ByteToGigabyteConverter" />
            <converters:EnumDescriptionConverter x:Key="EnumDescConverter" />

            <ObjectDataProvider x:Key="SyncProfileEnum"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="sync:SyncProfileTypes" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="FileCheckMethodEnum"
                        MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="prims:FileCheckMethod" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <ui:SettingsCard Header="Sync Profile" Description="Actions completed during a Sync." MinWidth="300" >
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DoubleSwipeDown_20_Regular}"/>
            </ui:SettingsCard.HeaderIcon>
            <ComboBox ItemsSource="{Binding Source={StaticResource SyncProfileEnum}}"
                              SelectedItem="{Binding ExtendedSyncSettings.SyncProfile, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Converter={StaticResource SyncProfileConverter}}" />

                            <TextBlock Text="{Binding Converter={StaticResource SyncProfileConverter}, ConverterParameter=Description}"
                                   TextWrapping="WrapWithOverflow" Opacity="0.6" MaxWidth="340"
                                   Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

        </ui:SettingsCard>

        <ui:SettingsCard Grid.Row="0" Header="Overwrite Metadata" Description="If game already exists in Launchbox, overwrite the metadata with that from Romm.">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextBulletListSquareEdit_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ExtendedSyncSettings.OverwriteMetadata, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:SettingsCard>  

        <ui:SettingsCard Grid.Row="0" Header="Local Rom File Check Method" Description="During sync, whether to check for existing any local rom files by existence only, or with an additional SHA1 check (slower but more reliable)">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DocumentTable_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox ItemsSource="{Binding Source={StaticResource FileCheckMethodEnum}}"
                        SelectedItem="{Binding ExtendedSyncSettings.FileCheckMethod, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Binds to the enum itself, but passes it through our converter -->
                        <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ui:SettingsCard>

        <ui:SettingsCard Grid.Row="0" Header="Overwrite Media" Description="If a media item already exists, does not overwrite with RomM media. Useful where you are using Launchbox for Media updates.">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ImageEdit_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ExtendedSyncSettings.OverwriteExistingMedia, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:SettingsCard>

        <ui:SettingsCard Grid.Row="0" Header="Force Media Priority" Description="Forces RomM media being used as the primary source by giving it the '-00' suffix. Also preserves any existing Launchbox media.">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ImageMultiple_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ExtendedSyncSettings.ForceMediaPriority, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:SettingsCard>


        <ui:SettingsCard Grid.Row="0" Header="Temporary Rom Files Download Path" 
                        Description="Where to download RomM's temporary zip files to before extraction to your installation.">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.FolderZip_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"  Width="auto" MaxWidth="500" Margin="0,0,10,0"
                         Text="{Binding ExtendedSyncSettings.TempDownloadsPath, ElementName=root, Mode=TwoWay, 
                                UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"  Content="Browse" Margin="0,0,10,0"></Button>
            </Grid>
        </ui:SettingsCard>

        <ui:SettingsCard Grid.Row="0" Header="Bulk Rom Batch Size (GB)" 
                         Description="RommStar downloads RomM files in batches. This is the maximum size of these batches. Must be greater than the likely largest rom size for a platform. ">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DocumentFolder_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:NumberBox MinWidth="100"                
                Value="{Binding ExtendedSyncSettings.TargetRomBatchFilesizeGb, ElementName=root, 
                Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ByteToGigabyteConverter}}" />
        </ui:SettingsCard>

        <ui:SettingsCard Grid.Row="0" Header="Remove Old Server Roms" IsEnabled="False"
                        Description="DEV: Disabled - now removes old server roms autoamtically. Sig code needed to preserve option. If local launchbox platform contains roms from a previously assigned server, these are deleted.">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ExtendedSyncSettings.DeleteOldServerRoms, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:SettingsCard>

        <ui:SettingsCard Grid.Row="0" Header="Individual Game Folders" IsEnabled="False"
                        Description="DEV: Disabled. Files now put where app dictates. Downloaded roms are placed in their own folders in the Platform Rom Directory">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ExtendedSyncSettings.UseIndividualGameFolders, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:SettingsCard>

    </StackPanel>
</UserControl>
