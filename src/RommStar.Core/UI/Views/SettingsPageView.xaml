<Page x:Class="RommStar.Core.UI.Views.SettingsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RommStar.Core.UI.Views"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:vm="clr-namespace:RommStar.Core.UI.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SettingsPageVM, IsDesignTimeCreatable=True}"
      d:DesignHeight="450" d:DesignWidth="800" d:Background="#202020" d:Foreground="Gainsboro"
      Title="Settings">

    <TabControl ui:TabControlHelper.IsAddTabButtonVisible="False">

        <TabItem Header="Romm" ui:TabItemHelper.IsClosable="False">
            <ui:TabItemHelper.Icon>
                <Image Source="/RommStar.Core;component/Resources/rommIcon64px.png" />
            </ui:TabItemHelper.Icon>
            <TextBlock Text="Content 1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </TabItem>

        <!-- APPLICATION SETTINGS -->
        <TabItem Header="Application" ui:TabItemHelper.IsClosable="False">
            <ui:TabItemHelper.Icon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AppGeneric_20_Regular}" />
            </ui:TabItemHelper.Icon>
            <StackPanel>
                <ui:ToggleSwitch x:Name="DarkModeToggle" Header="Dark Mode" Margin="0,0,0,12" Toggled="ToggleSwitch_Toggled" />
            </StackPanel>
        </TabItem>

        <TabItem Header="TabItem 3">
            <TextBlock Text="Content 3" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </TabItem>
    </TabControl>
</Page>